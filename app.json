{
  "expo": {
    "name": "AucWin",
    "slug": "harbour-crm",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexuscrm",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auctechmarcom.aucwin",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph client documents.",
        "NSPhotoLibraryUsageDescription": "Used to attach documents and photos to leads and clients.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.auctechmarcom.aucwin",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F2F58"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE"
      ],
      "backgroundColor": "#F1F4F8"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F2F58"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#12ACA2"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow AucWin to use the camera to capture documents."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-status-bar",
      "./plugins/withHardwareFeatures"
    ],
    "backgroundColor": "#F1F4F8",
    "extra": {
      "eas": {
        "projectId": "09ebf319-8341-44be-9cb1-3f307a857c85"
      }
    }
  }
}